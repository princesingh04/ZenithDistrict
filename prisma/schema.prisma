generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  LIVE
  COMING_SOON
}

enum SectionStatus {
  COMING_SOON
  LIVE
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  category    String
  url         String
  status      ProductStatus @default(LIVE)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model SiteSection {
  id        String        @id @default(cuid())
  key       String        @unique // "brands" | "labs"
  status    SectionStatus @default(COMING_SOON)
  updatedAt DateTime      @updatedAt
}

model LoginAttempt {
  id          String    @id @default(cuid())
  key         String    @unique // e.g. "127.0.0.1:admin"
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([lockedUntil])
}

